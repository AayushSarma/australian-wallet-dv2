{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "gridColor": "#E6E7E2"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  },
  "width": "container",
  "data": {
    "url": "data/category_months.csv"
  },
  "transform": [
    {
      "filter": "datum.month === 'Jun 2026' || datum.month === 'Aug 2026'"
    }
  ],
  "height": 280,
  "mark": {
    "type": "line",
    "point": {
      "filled": true,
      "size": 70
    }
  },
  "encoding": {
    "x": {
      "field": "monthIndex",
      "type": "ordinal",
      "axis": {
        "title": null,
        "values": [
          0,
          2
        ],
        "labelExpr": "datum.value == 0 ? 'June 2026' : 'August 2026'"
      }
    },
    "y": {
      "field": "change",
      "type": "quantitative",
      "title": "Month-on-month spending change (%)"
    },
    "detail": {
      "field": "category"
    },
    "color": {
      "field": "category",
      "type": "nominal",
      "legend": {
        "orient": "bottom",
        "columns": 3
      }
    },
    "tooltip": [
      {
        "field": "category"
      },
      {
        "field": "month"
      },
      {
        "field": "change",
        "type": "quantitative",
        "title": "Month-on-month spending change (%)"
      }
    ]
  }
}