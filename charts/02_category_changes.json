{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "gridColor": "#E6E7E2"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  },
  "width": "container",
  "data": {
    "url": "data/category_months.csv"
  },
  "transform": [
    {
      "filter": "datum.month === 'Aug 2026'"
    }
  ],
  "height": 300,
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "category",
      "type": "nominal",
      "sort": "-x",
      "title": null
    },
    "x": {
      "field": "change",
      "type": "quantitative",
      "title": "Month-on-month spending change (%)"
    },
    "color": {
      "condition": {
        "test": "datum.change > 0",
        "value": "#287A78"
      },
      "value": "#BD6470"
    },
    "tooltip": [
      {
        "field": "category"
      },
      {
        "field": "change",
        "type": "quantitative",
        "title": "Month-on-month spending change (%)"
      }
    ]
  }
}