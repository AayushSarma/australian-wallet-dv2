            "change": -0.6,
            "magnitude": 0.6
          },
          {
            "state": "NT",
            "city": "Darwin",
            "longitude": 130.84,
            "latitude": -12.46,
            "change": 1.1,
            "magnitude": 1.1
          },
          {
            "state": "ACT",
            "city": "Canberra",
            "longitude": 149.13,
            "latitude": -35.28,
            "change": 4.2,
            "magnitude": 4.2
          }
        ]
      },
      "mark": {
        "type": "circle",
        "opacity": 0.85,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "magnitude",
          "type": "quantitative",
          "title": "Absolute transport change (%)",
          "scale": {
            "range": [
              65,
              1100
            ]
          }
        },
        "color": {
          "condition": {
            "test": "datum.change >= 0",
            "value": "#287A78"
          },
          "value": "#BD6470"
        },
        "tooltip": [
          {
            "field": "state"
          },
          {
            "field": "city"
          },
          {
            "field": "change",
            "title": "Transport change (%)"
          }
        ]
      }
    }
  ]
}