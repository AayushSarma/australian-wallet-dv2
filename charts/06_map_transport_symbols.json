{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "gridColor": "#E6E7E2"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  },
  "width": "container",
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 650
  },
  "height": 310,
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#DDE5E1",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "NSW",
