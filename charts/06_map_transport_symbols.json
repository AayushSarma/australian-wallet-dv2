            "latitude": -33.87,
            "change": 3.4,
            "magnitude": 3.4
          },
          {
            "state": "VIC",
            "city": "Melbourne",
            "longitude": 144.96,
            "latitude": -37.81,
            "change": 0.9,
            "magnitude": 0.9
          },
          {
            "state": "QLD",
            "city": "Brisbane",
            "longitude": 153.03,
            "latitude": -27.47,
            "change": 1.9,
            "magnitude": 1.9
          },
          {
            "state": "SA",
            "city": "Adelaide",
            "longitude": 138.6,
            "latitude": -34.93,
            "change": 3.6,
            "magnitude": 3.6
          },
          {
            "state": "WA",
            "city": "Perth",
            "longitude": 115.86,
